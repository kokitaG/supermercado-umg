# ============================================================================
# CONFIGURACIÓN DEL SISTEMA DE GESTIÓN PARA SUPERMERCADO
# ============================================================================

# Para conectar a PostgreSQL local:
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/supermercado_db

# Para conectar a Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Por defecto, si no se especifica DATABASE_URL o PostgreSQL no está activo,
# el backend utilizará SQLite automáticamente para permitir ejecución inmediata sin errores:
DATABASE_URL=sqlite:///./supermercado.db

# Configuración JWT y Seguridad
SECRET_KEY=supermercado_umg_secret_key_2026_segura_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Puerto del Backend
PORT=8000
HOST=0.0.0.0
